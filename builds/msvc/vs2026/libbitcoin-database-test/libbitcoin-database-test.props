<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>libbitcoin-database-test Settings</_PropertySheetDisplayName>
  </PropertyGroup>

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Condition="Exists('$(MSBuildThisFileDirectory)libbitcoin-database-test.xml')" Include="$(MSBuildThisFileDirectory)libbitcoin-database-test.xml" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
    <PostBuildEvent Condition="'$(DebugOrRelease)' == 'Release'">
      <Command>"$(TargetPath)" --log_level=warning --run_test=* --show_progress=no --build_info=yes</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(SolutionDir)libbitcoin-system.import.props" />
    <Import Project="$(SolutionDir)libbitcoin-database.import.props" />
  </ImportGroup>

  <PropertyGroup>
    <Linkage-libbitcoin-system>$(DefaultLinkage)</Linkage-libbitcoin-system>
    <Linkage-libbitcoin-database>$(DefaultLinkage)</Linkage-libbitcoin-database>
  </PropertyGroup>

  <Target Name="LinkageInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Linkage-libbitcoin-system   : $(Linkage-libbitcoin-system)" Importance="high"/>
    <Message Text="Linkage-libbitcoin-database : $(Linkage-libbitcoin-database)" Importance="high"/>
  </Target>

</Project>
