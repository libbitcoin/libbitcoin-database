<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>libbitcoin-database Settings</_PropertySheetDisplayName>
  </PropertyGroup>

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Condition="Exists('$(MSBuildThisFileDirectory)libbitcoin-database.xml')" Include="$(MSBuildThisFileDirectory)libbitcoin-database.xml" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(RepoRoot)build\include\;$(RepoRoot)include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'DynamicLibrary'">BCD_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'StaticLibrary'">BCD_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(SolutionDir)libbitcoin-system.import.props" />
  </ImportGroup>

  <PropertyGroup>
    <Linkage-libbitcoin-system>$(DefaultLinkage)</Linkage-libbitcoin-system>
  </PropertyGroup>

  <Target Name="LinkageInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Linkage-libbitcoin-system : $(Linkage-libbitcoin-system)" Importance="high"/>
  </Target>

</Project>
